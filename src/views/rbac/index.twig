{% if mermaidAvailable %}
{{ register_asset_bundle('dmstr/web/MermaidAsset') }}

<div class="box" style="">
    <div class="box-header with-border">
        Roles and Permissions
    </div>
    <div class="mermaid" style="overflow: scroll">
        {{ mmd|raw }}
    </div>
</div>
{% else %}
<div class="callout callout-warning">
    <h4><i class="icon fa fa-warning"></i> {{ t('backend-module', 'Can not display diagram, Mermaid Asset not available') }}</h4>
    <p>{{ t('backend-module', 'Please install dmstr/yii2-mermaid-asset and the mermaid npm package.') }}</p>
</div>
{% endif %}
